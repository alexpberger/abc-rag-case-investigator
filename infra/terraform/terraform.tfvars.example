location                  = "eastus2"
resource_group_name       = "rg-abc-rag-case-investigator"
openai_account_name       = "oai-abc-rag-demo-change-me"
chat_deployment_name      = "gpt-4.1"
chat_model_name           = "gpt-4.1"
chat_model_version        = "2025-04-14"
chat_capacity             = 10
embedding_deployment_name = "text-embedding-3-small"
embedding_model_name      = "text-embedding-3-small"
embedding_model_version   = "1"
embedding_capacity        = 10

# Public Container App. Names must be unique in the subscription or globally, as noted on each variable.
# Leave deploy_container_app false for the first local apply. A push to main sets it true. See the README.
acr_name                       = "acrabcragdemochangeme"
log_analytics_workspace_name   = "log-abc-rag-demo"
container_app_environment_name = "cae-abc-rag-demo"
container_app_name             = "ca-abc-rag-demo"
# Bootstrap tag only. A push to main applies the commit SHA instead.
image_tag                      = "1"
deploy_container_app           = false
# Repository that may deploy main. Repositories created after 15 July 2026 use owner@id/name@id.
# Do not commit a real mailbox below.
github_repository              = "owner/abc-rag-case-investigator"
monthly_budget_usd             = 50
# First instant of the current month. Azure rejects a start date outside the current time grain.
budget_start_date              = "2026-11-01T00:00:00Z"
# Replace this placeholder in terraform.tfvars. Do not put a real mailbox in this example file.
budget_alert_email             = "you@example.com"
