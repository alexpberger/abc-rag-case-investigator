# Copy this file to .env and fill in the Azure values.
# .env is gitignored. Never commit API keys or real connection strings.
#
# The database password below is the published local Docker default.
# It is not an Azure credential.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cases

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KNOWLEDGE_DIR=knowledge

# Public demo. Defaults are fine for local development.
# USAGE_LIMITS_ENABLED=true
# INVESTIGATE_DAILY_LIMIT=100
# ASK_DAILY_LIMIT=300
# INVESTIGATE_HOURLY_LIMIT=10
# ASK_HOURLY_LIMIT=30
# TRUST_PROXY=false
# EXPOSE_API_DOCS=true

# Read by Vite. Do not prefix Azure secrets with VITE_.
VITE_API_BASE_URL=http://localhost:8000
